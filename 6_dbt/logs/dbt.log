    3, 'DEF', 'Deficiente', 2, 'Medio', 0.25

UNION ALL SELECT
    4, 'DUD', 'Dudoso', 3, 'Alto', 0.60

UNION ALL SELECT
    5, 'PER', 'Pérdida', 4, 'Muy alto', 1.00
  );
  
